<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="150dp">

    <TextView
        android:id="@+id/tvSongCountNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:paddingStart="12dp"
        android:paddingEnd="0dp"
        android:paddingTop="13.5dp"
        android:text="0"
        android:textColor="#B3B3B3"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </TextView>

    <TextView
        android:id="@+id/tvSongCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:paddingTop="12dp"
        android:text="首歌，"
        android:textColor="#B3B3B3"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/tvSongCountNum">

    </TextView>

    <TextView
        android:id="@+id/tvTimeCountNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:gravity="left"
        android:paddingTop="13.5dp"
        android:text="0"
        android:textColor="#B3B3B3"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/tvSongCountNum"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTimeCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:text="分钟"
        android:textColor="#B3B3B3"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/tvTimeCountNum">

    </TextView>

    <TextView
        android:id="@+id/tvCopyRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:text="UnKnown Publisher"
        android:textColor="#B3B3B3"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSongCount">

    </TextView>

</androidx.constraintlayout.widget.ConstraintLayout>