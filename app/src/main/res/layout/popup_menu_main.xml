<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 导入音乐 -->
    <LinearLayout
        android:id="@+id/layout_import"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:foreground="@drawable/bg_song_selected">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/place_item_icon"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="导入音乐"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#22000000"/>

    <!-- 编辑排序（父项） -->
    <LinearLayout
        android:id="@+id/layout_sort"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:foreground="@drawable/bg_song_selected">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/sort_icon"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="编辑排序"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/menu_arrow_right_icon" />

    </LinearLayout>

    <!-- 最近添加（子菜单项） -->
    <LinearLayout
        android:id="@+id/layout_recent"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="32dp"
        android:paddingEnd="12dp"
        android:foreground="@drawable/bg_song_selected"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="添加日期"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333" />

        <ImageView
            android:id="@+id/icon_recent_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/check_icon"
            android:visibility="visible" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#22000000"/>

    <!-- 字母顺序（子菜单项） -->
    <LinearLayout
        android:id="@+id/layout_alphabetical"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="32dp"
        android:paddingEnd="12dp"
        android:foreground="@drawable/bg_song_selected"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="字母顺序"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333" />

        <ImageView
            android:id="@+id/icon_alphabetical_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/check_icon"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 设置 -->
    <LinearLayout
        android:id="@+id/layout_settings"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:foreground="@drawable/bg_song_selected">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/settings_icon"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设置"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#333333" />

    </LinearLayout>
</LinearLayout>