<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerRoot"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 遮罩 -->
    <View
        android:id="@+id/dimBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:visibility="gone" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_bg"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="-133dp">


        <View
            android:id="@+id/view2"
            android:layout_width="90dp"
            android:layout_height="7dp"
            android:layout_marginTop="68dp"
            android:background="@drawable/pill_bg_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/song_detail_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            app:layout_constraintBottom_toTopOf="@+id/playBottom_player"
            app:layout_constraintTop_toBottomOf="@+id/view2"
            app:layout_constraintVertical_bias="0.458"
            tools:layout_editor_absoluteX="8dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView_player"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imgCover_detail_player"
                    android:layout_width="355dp"
                    android:layout_height="355dp"
                    android:scaleType="centerCrop" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/song_name_player"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginStart="28dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#000000"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardView_player"
                app:layout_constraintEnd_toStartOf="@+id/icon_like_player"
                app:layout_constraintVertical_bias="0.41" />

            <TextView
                android:id="@+id/song_artist_player"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginStart="28dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3B3B3"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/song_name_player"
                app:layout_constraintEnd_toStartOf="@+id/icon_like_player" />

            <ImageButton
                android:id="@+id/icon_like_player"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginEnd="28dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@drawable/hollow_favorite_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.948" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playBottom_player"
            android:layout_width="325dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="120dp"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageButton
                android:id="@+id/icon_skip_next_player"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:src="@drawable/skip_next_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/icon_skip_previous_player"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:src="@drawable/skip_previous_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/icon_play_player"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:src="@drawable/pause_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/icon_skip_next_player"
                app:layout_constraintStart_toStartOf="@id/icon_skip_previous_player"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/time_player"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="-1dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintBottom_toTopOf="@+id/playBottom_player"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/song_detail_player">

        </TextView>

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="70dp"
            android:thumb="@null"
            android:background="@null"
            android:progressDrawable="@drawable/seekbar_pill"
            app:layout_constraintBottom_toTopOf="@+id/playBottom_player"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/song_detail_player" />

        <ImageButton
            android:id="@+id/icon_playOrder_player"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="56dp"
            android:layout_marginTop="30dp"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@drawable/repeat_one_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/playBottom_player" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>